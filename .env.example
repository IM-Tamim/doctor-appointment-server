# Copy to .env and fill in. Values here are placeholders.

# ── Core ─────────────────────────────────────────────────────────────
MONGO_URI=mongodb://user:password@host1:27017,host2:27017/?replicaSet=...&tls=true&authSource=admin
# Database name (default: DocAppoint). Use a scratch name for local testing.
DB_NAME=DocAppoint
PORT=8000
# The Next.js app's origin (CORS + links in emails/notifications).
CLIENT_URL=http://localhost:3000
# Extra allowed CORS origins, comma separated (optional).
EXTRA_ORIGINS=
# Public URL of THIS API, used for SSLCommerz callbacks and prescription QR links.
SERVER_PUBLIC_URL=http://localhost:8000
# DNS servers used if the OS resolver can't do SRV lookups (optional).
DNS_SERVERS=8.8.8.8,1.1.1.1
# Clinic time zone offset for slots and serials (default Bangladesh, +06:00).
APP_TZ_OFFSET=+06:00

# ── Email (Gmail app password) ───────────────────────────────────────
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── Payments: SSLCommerz (leave blank to hide the gateway) ───────────
# Sandbox credentials: https://developer.sslcommerz.com/registration/
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWORD=
SSLCZ_IS_LIVE=false

# ── AI symptom assistant (optional, free) ────────────────────────────
# Free key from Google AI Studio: https://aistudio.google.com/apikey
# Without a key the assistant falls back to built-in keyword rules.
GEMINI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
